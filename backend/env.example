# Never commit real secrets.
PORT=5000
NODE_ENV=production

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000

# Database secret in AWS Secrets Manager.
AWS_REGION=ap-south-1
DB_SECRET_ID=devconnect-rds-secret

# JWT option 1: inject JWT_SECRET through the runtime environment.
# Do NOT put the real value in this file.
JWT_SECRET=

# JWT option 2: set a Secrets Manager secret ID instead of JWT_SECRET.
JWT_SECRET_SECRET_ID=

JWT_EXPIRES_IN=1h

# RDS TLS certificate bundle. Set this in production if your OS trust store
# does not already trust the RDS CA.
RDS_CA_CERT_PATH=/etc/devconnect/certs/global-bundle.pem

LOG_FILE=/var/log/devconnect/app.log
